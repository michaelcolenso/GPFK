# Database
DATABASE_URL=postgresql://harbinger:harbinger@localhost:5432/harbinger

# OpenSky Network (free tier: no auth needed, or register for higher limits)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# SEC EDGAR (no auth needed, but set a user-agent per their policy)
EDGAR_USER_AGENT="YourCompany admin@yourcompany.com"

# API settings
API_SECRET_KEY=change-me-in-production
RATE_LIMIT_PER_MINUTE=60

# Collection schedule (cron expressions)
EDGAR_COLLECT_CRON="0 */4 * * *"
FLIGHT_COLLECT_CRON="*/30 * * * *"
JOBS_COLLECT_CRON="0 8 * * *"
